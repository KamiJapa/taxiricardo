{
  "name": "taxi-aeroporto-ricardo",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page local do Táxi Aeroporto — Ricardo.",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./tailwind.css --watch",
    "build": "node scripts/seo.mjs && tailwindcss -i ./src/input.css -o ./tailwind.css --minify && node scripts/package.mjs",
    "test:static": "node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "wrangler": "4.154.0"
  }
}
